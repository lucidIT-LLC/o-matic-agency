# Deploy values for scripts/build-m365-deploy.mjs. Copy this file outside the
# repository, fill it in, and pass it with --env. Never commit the filled copy.
#
# OMATIC_MCP_URL            HTTPS MCP endpoint. Must equal the Base URL of the
#                           Teams Developer Portal Entra SSO registration.
# OMATIC_ENTRA_SSO_AUTH_ID  The registration ID (OAuthPluginVault reference_id).
#                           One registration serves every package only when
#                           "Restrict usage by app" is "Any Teams app".
# TEAMS_APP_ID_<ROLE>       One stable GUID per agent. Keep it across builds so
#                           an upload updates the same agent instead of adding one.
OMATIC_MCP_URL=https://replace-at-deploy.invalid/mcp
OMATIC_ENTRA_SSO_AUTH_ID=TODO-entra-sso-auth-id
TEAMS_APP_ID_PROBOT=00000000-0000-4000-8000-000000000001
TEAMS_APP_ID_FRED=00000000-0000-4000-8000-000000000002
TEAMS_APP_ID_DATA=00000000-0000-4000-8000-000000000003
