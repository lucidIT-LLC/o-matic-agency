{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.30/MicrosoftTeams.schema.json",
  "manifestVersion": "1.30",
  "version": "1.12.2",
  "id": "${{TEAMS_APP_ID}}",
  "developer": {
    "name": "lucidIT, LLC (o-MATIC)",
    "websiteUrl": "https://o-matic.ai",
    "privacyUrl": "https://www.o-matic.ai/privacy-policy/",
    "termsOfUseUrl": "https://www.o-matic.ai/terms-of-service/"
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "name": {
    "short": "Probot (o-MATIC)",
    "full": "Probot, Orchestrator from o-MATIC"
  },
  "description": {
    "short": "Orchestrator. Turns intent into plans, owners and next steps.",
    "full": "Orchestrator from o-MATIC. Turn human intent into crisp, executable structure."
  },
  "accentColor": "#00B5AD",
  "copilotAgents": {
    "declarativeAgents": [
      {
        "id": "probotAgent",
        "file": "declarativeAgent.json"
      }
    ]
  },
  "permissions": [
    "identity"
  ],
  "validDomains": []
}
