{
  "$schema": "https://developer.microsoft.com/json-schemas/copilot/plugin/v2.4/schema.json",
  "schema_version": "v2.4",
  "name_for_human": "Fred (o-MATIC)",
  "description_for_human": "Read-only o-MATIC Server tools for Fred.",
  "namespace": "omaticfred",
  "functions": [
    {
      "name": "connections_list",
      "capabilities": {
        "confirmation": {
          "type": "None"
        }
      }
    },
    {
      "name": "omatic_guide",
      "capabilities": {
        "confirmation": {
          "type": "None"
        }
      }
    },
    {
      "name": "search",
      "capabilities": {
        "confirmation": {
          "type": "None"
        }
      }
    },
    {
      "name": "proposal_vault_list",
      "capabilities": {
        "confirmation": {
          "type": "None"
        }
      }
    },
    {
      "name": "proposal_vault_get",
      "capabilities": {
        "confirmation": {
          "type": "None"
        }
      }
    },
    {
      "name": "ocr_result_get",
      "capabilities": {
        "confirmation": {
          "type": "None"
        }
      }
    }
  ],
  "runtimes": [
    {
      "type": "RemoteMCPServer",
      "auth": {
        "type": "OAuthPluginVault",
        "reference_id": "${{OMATIC_ENTRA_SSO_AUTH_ID}}"
      },
      "run_for_functions": [
        "connections_list",
        "omatic_guide",
        "search",
        "proposal_vault_list",
        "proposal_vault_get",
        "ocr_result_get"
      ],
      "spec": {
        "url": "${{OMATIC_MCP_URL}}",
        "mcp_tool_description": {
          "file": "mcp-tools.json"
        }
      }
    }
  ],
  "privacy_policy_url": "https://www.o-matic.ai/privacy-policy/",
  "legal_info_url": "https://www.o-matic.ai/terms-of-service/"
}
